# Verilay — environment variables
# Copy this file to .env and fill in your values
# Never commit your actual .env file to GitHub

# GitHub Personal Access Token (free)
# Get one at: https://github.com/settings/tokens
# Scopes needed: repo (read-only is fine for public repos)
# Without this: 60 API requests/hour  |  With this: 5,000/hour
GITHUB_TOKEN=your_github_token_here

# Anthropic API Key — powers the AI analysis
# Get one at: https://console.anthropic.com
# Each Verilay analysis costs approximately $0.01–0.03 in API credits
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# Signed cookies — REQUIRED once anyone can sign in
# ─────────────────────────────────────────────────────────────────────────────
# Signs the sign-in cookie. If this is missing, each Gunicorn worker invents its
# own random key and signed-in users get logged out at random.
# Generate one with:  py -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=
# The key the app uses for reports, stats and purchases (service role).
SUPABASE_KEY=
# The anon / publishable key, used only for signing people in. Keep them
# separate: sign-in should not be done with a key that can read every table.
SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Stripe — the $19 deep scan
# ─────────────────────────────────────────────────────────────────────────────
# Master switch. Leave OFF until the deep scan engine actually exists — with it
# off, /deep-scan shows "coming soon" and no checkout can be created.
PAYWALL_ENABLED=0

# Use a RESTRICTED key (rk_...), not the account secret key. This Stripe account
# is shared with your other apps, so a restricted key keeps a leak scoped to
# Verilay. Needs write on Checkout Sessions, and read on Sessions + Payment
# Intents. Test keys start rk_test_ / sk_test_.
STRIPE_SECRET_KEY=

# From the webhook endpoint you create in the Stripe dashboard. Each endpoint has
# its own signing secret — the local Stripe CLI gives you a different one.
STRIPE_WEBHOOK_SECRET=

# Optional. If set, checkout uses this dashboard Price. If blank, the price below
# is used inline, which is handy for testing before the product exists.
STRIPE_PRICE_ID=

# Only used when STRIPE_PRICE_ID is blank. 1900 = $19.00
DEEP_SCAN_PRICE_CENTS=1900
DEEP_SCAN_CURRENCY=aud

# Stripe tax classification. Required — this account has Managed Payments enabled
# (Stripe is merchant of record and handles tax), and it rejects any line item
# without an eligible product tax code. The default below is
# "Software as a service (SaaS) - business use", which is what a deep scan is.
# If you ever create the product in the dashboard instead, set the tax code THERE
# too — the dashboard product does not inherit this.
DEEP_SCAN_TAX_CODE=txcd_10103001

# Where Stripe sends people back to. Must match the real origin exactly, or the
# success and cancel redirects land on the wrong host.
BASE_URL=https://verilay.dev

# Local development only. Session cookies are Secure-only by default, which means
# they are not sent over plain http://localhost. Set this to 1 to test sign-in
# locally. NEVER set it in production.
# COOKIE_INSECURE=1

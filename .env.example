# Verilay — environment variables
# Copy this file to .env and fill in your values
# Never commit your actual .env file to GitHub

# GitHub Personal Access Token (free)
# Get one at: https://github.com/settings/tokens
# Scopes needed: repo (read-only is fine for public repos)
# Without this: 60 API requests/hour  |  With this: 5,000/hour
GITHUB_TOKEN=your_github_token_here

# Anthropic API Key — powers the AI analysis
# Get one at: https://console.anthropic.com
# Each Verilay analysis costs approximately $0.01–0.03 in API credits
ANTHROPIC_API_KEY=your_anthropic_api_key_here
